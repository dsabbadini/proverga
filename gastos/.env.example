# Token secreto usado pelo celular (MacroDroid) e pelo dashboard. Gere um longo e aleatório.
APP_TOKEN=troque-por-um-token-longo-e-aleatorio
PORT=3000
# 127.0.0.1 = só este aparelho acessa (recomendado no celular). Use 0.0.0.0 em servidor na nuvem.
HOST=127.0.0.1
# Caminho do banco SQLite (use um volume persistente em produção)
DB_PATH=./data/gastos.db
